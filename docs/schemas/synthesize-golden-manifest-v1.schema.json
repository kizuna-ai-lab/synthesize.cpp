{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handy.computer/schemas/synthesize-golden-manifest-v1.schema.json",
  "title": "synthesize.cpp Golden Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_version",
    "family",
    "variant",
    "source",
    "reference",
    "package_contract",
    "tolerance_file",
    "case_artifact_root",
    "cases",
    "relations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "synthesize-golden-manifest-v1"
    },
    "suite_version": {
      "type": "integer",
      "minimum": 1
    },
    "family": {
      "$ref": "#/$defs/key"
    },
    "variant": {
      "$ref": "#/$defs/key"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "package_contract": {
      "$ref": "#/$defs/packageContract"
    },
    "tolerance_file": {
      "$ref": "#/$defs/relativePath"
    },
    "case_artifact_root": {
      "$ref": "#/$defs/relativePath"
    },
    "suite_status": {
      "description": "Additive, optional. TWO things read this field: the top-level if/then below, where \"incremental\" relaxes cases.minItems from 12 to 0; and tests/python/test_golden_manifests.py's suite_status guard, which asserts the set of manifests carrying it equals a named allowlist AND that carrying it means zero cases while omitting it means at least twelve. That guard was added 2026-08-19 because the schema and the Python checks previously waived the floor on different conditions and neither knew about the other. Existed because qwen3-tts-12hz-1-7b-voicedesign was the first Reference Model Variant committed before its case suite existed. That interval is CLOSED: its 13 cases landed 2026-08-19 and the field was removed from it, so the allowlist is now empty and NO committed manifest carries this field. Kept in the schema because the floor is a Confirmed contract that a future manifest must opt INTO relaxing, not one a manifest-wide default can quietly drop -- and any manifest that opts in must also be added to that allowlist, or the guard fails.",
      "const": "incremental"
    },
    "cases": {
      "description": "Twelve to thirty-two deterministic Port Validation Cases (docs/port-validation.md) for a manifest with no suite_status. The floor is waived to zero only when suite_status is exactly \"incremental\" -- see the top-level if/then below -- for a manifest deliberately committed before its case suite exists.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "if": {
    "properties": {
      "suite_status": { "const": "incremental" }
    },
    "required": ["suite_status"]
  },
  "then": {
    "properties": {
      "cases": { "minItems": 0 }
    }
  },
  "else": {
    "properties": {
      "cases": { "minItems": 12 }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "locator", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "checkpoint",
            "config",
            "source",
            "frontend-resource",
            "license",
            "reference-audio"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "terms": {
          "description": "Optional. What is known about this artifact's licence terms, for an artifact whose publisher declares none. A locator plus a digest records WHERE a thing came from; this records what the project may and may not say about it. Never a grant: the manifest cannot create rights, and an artifact this repository does not redistribute needs none.",
          "type": "string",
          "minLength": 1
        },
        "repository_path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "artifacts"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourceArtifact"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "framework",
        "runner",
        "environment_lock",
        "dtype",
        "device"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "$ref": "#/$defs/relativePath"
        },
        "environment_lock": {
          "$ref": "#/$defs/relativePath"
        },
        "dtype": {
          "type": "string",
          "enum": ["float32", "float16", "bfloat16"]
        },
        "device": {
          "type": "string",
          "enum": ["cpu", "cuda", "metal", "vulkan"]
        }
      }
    },
    "nativeAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate_hz", "channels", "sample_format"],
      "properties": {
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "sample_format": {
          "const": "f32le"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "contract_version"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "phoneme_mapping": {
          "type": "string",
          "enum": ["unicode_scalar", "delimited_symbol"]
        },
        "padding_rule": {
          "type": "string",
          "enum": ["interleaved_blank", "wrap_pad_token"]
        }
      }
    },
    "voices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "preset_ids"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fixed-default", "preset-catalog", "profile-sources"]
        },
        "default_id": {
          "type": ["string", "null"]
        },
        "preset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profileContract": {
      "description": "Declares that this package's Voices are constructed from a Voice Profile (reference audio, description text, and/or a serialized profile blob) rather than only a preset catalog. Additive, optional widening: present only on a packageContract whose voices.mode is profile-sources; every previously-committed manifest omits it and stays valid. `reference` is required only when `reference_audio` is among `sources` -- a package whose only declared source is `description_text` builds no Voice Profile from a recording, so it has no reference-audio limits to pin (weights.cpp's read_profile_and_speaker_encoder reads the synthesize.reference.* block only when the package carries a speaker encoder, which it cross-checks against exactly the same condition). Widened 2026-08-19, Stage 3 Plan 2 Task 7, to admit `description_text` and this conditional requirement: until then every profileContract in the tree happened to declare reference_audio, so `reference` being unconditionally required was indistinguishable from being required only for that source.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "sources"],
      "properties": {
        "schema": {
          "$ref": "#/$defs/key"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["reference_audio", "description_text", "serialized_profile"]
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_sample_rate",
            "target_channels",
            "min_frames_per_clip",
            "max_frames_per_clip",
            "max_total_frames",
            "max_reference_count"
          ],
          "properties": {
            "target_sample_rate": {
              "type": "integer",
              "minimum": 1
            },
            "target_channels": {
              "type": "integer",
              "minimum": 1
            },
            "min_frames_per_clip": {
              "type": "integer",
              "minimum": 1
            },
            "max_frames_per_clip": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_frames": {
              "type": "integer",
              "minimum": 1
            },
            "max_reference_count": {
              "type": "integer",
              "const": 1,
              "description": "Exactly 1, not merely at least 1. Every family that declares a `profile.reference` block builds a Voice Profile from references[0] and nothing else, and since 2026-08-13 both loaders (weights.cpp's read_profile_contract, in arch/qwen3-tts and arch/omnivoice) refuse a package declaring anything else -- so a manifest permitted to say 2 here would convert without complaint into a package that fails to load. A family that genuinely fuses or selects among several clips widens this in the same change that widens its loader rule, never before it."
            }
          }
        }
      },
      "if": {
        "properties": {
          "sources": {
            "contains": { "const": "reference_audio" }
          }
        },
        "required": ["sources"]
      },
      "then": {
        "required": ["reference"]
      }
    },
    "packageContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_audio",
        "input_kinds",
        "frontend",
        "language_tags",
        "voices",
        "stochastic",
        "speaking_rate_range",
        "max_input_tokens",
        "max_output_frames"
      ],
      "properties": {
        "native_audio": {
          "$ref": "#/$defs/nativeAudio"
        },
        "input_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["text_utf8", "phonemes_utf8", "token_ids"]
          }
        },
        "frontend": {
          "oneOf": [
            {
              "$ref": "#/$defs/frontend"
            },
            {
              "type": "null"
            }
          ]
        },
        "language_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "voices": {
          "$ref": "#/$defs/voices"
        },
        "profile": {
          "$ref": "#/$defs/profileContract"
        },
        "stochastic": {
          "type": "boolean"
        },
        "speaking_rate_range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_frames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "generatedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "format"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "type": "string",
          "enum": ["i32le", "i64le", "f32le", "json"]
        }
      }
    },
    "stochasticInput": {
      "description": "A stochastic-input capture read from the local oracle dump. `sha256`, when present, pins the digest of the file at `path` (resolved under the case's own oracle directory): a mismatch means the oracle dump on this machine is not the one the manifest describes, checked before anything is compared against it. Optional here because this type is shared across every family's manifest and only some record it; a family's own structural test is where 'every case must carry one' is enforced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "format"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "type": "string",
          "enum": ["i32le", "i64le", "f32le", "json"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "alternateGrid": {
      "description": "A second reference-produced token grid this case's port output may equal. `file` is committed and resolved relative to the manifest, and its bytes are pinned by `sha256`: the admissible set is enumerated by digest and is never widened by a tolerance. `provenance` says which reference run produced it and under which decision it was admitted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "provenance"],
      "properties": {
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "language_tag"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["text_utf8", "phonemes_utf8", "token_ids"]
        },
        "language_tag": {
          "type": ["string", "null"]
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "token_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "artifact": {
          "$ref": "#/$defs/generatedArtifact"
        },
        "reference": {
          "$ref": "#/$defs/caseReference"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "text_utf8"
            }
          },
          "required": ["text"]
        },
        {
          "properties": {
            "kind": {
              "const": "phonemes_utf8"
            }
          },
          "required": ["text"]
        },
        {
          "properties": {
            "kind": {
              "const": "token_ids"
            }
          },
          "oneOf": [
            {
              "required": ["token_ids"]
            },
            {
              "required": ["artifact"]
            }
          ]
        }
      ]
    },
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "transcript", "language_tag"],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "language_tag": {
          "type": ["string", "null"]
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "package_default",
            "preset_voice",
            "description_text",
            "reference_audio"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "oracle_id": {
          "type": ["integer", "string"]
        },
        "description": {
          "description": "An empty string is legal for a description_text Voice whose family treats it as a meaningful, no-instruction request -- qwen3-tts's design decision D3, exercised by this variant's own empty-instruct Port Validation Case. Widened from `minLength: 1` on 2026-08-19, Stage 3 Plan 2 Task 7, when that case needed to be expressible; every previously-committed description_text case (omnivoice's own two) carries a non-empty string regardless, so this widening changes nothing already committed.",
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "package_default"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "preset_voice"
            }
          },
          "required": ["id", "oracle_id"]
        },
        {
          "properties": {
            "kind": {
              "const": "description_text"
            }
          },
          "required": ["description"]
        },
        {
          "properties": {
            "kind": {
              "const": "reference_audio"
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_u64", "speaking_rate", "max_output_frames"],
      "properties": {
        "seed_u64": {
          "$ref": "#/$defs/u64"
        },
        "speaking_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_output_frames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "stochastic_inputs"],
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "integer", "string", "boolean", "null"]
          }
        },
        "stochastic_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stochasticInput"
          }
        },
        "alternate_grids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/alternateGrid"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifacts"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/generatedArtifact"
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["upstream_example", "project_coverage"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "coverage",
        "input",
        "voice",
        "request",
        "oracle",
        "checks",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/caseId"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input": {
          "$ref": "#/$defs/caseInput"
        },
        "voice": {
          "$ref": "#/$defs/voice"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tensor_parity",
              "structural_exactness",
              "waveform_regression",
              "finite_pcm",
              "request_repeatability",
              "result_metadata",
              "backend_placement",
              "resource_cleanup"
            ]
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "phase", "cases"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["artifact_differs", "frame_count_order"]
        },
        "phase": {
          "type": "string",
          "enum": ["oracle_replay", "public_request"]
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseId"
          }
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "string",
          "enum": ["increasing", "decreasing"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "artifact_differs"
              }
            }
          },
          "then": {
            "required": ["artifact"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "frame_count_order"
              }
            }
          },
          "then": {
            "required": ["order"]
          }
        }
      ]
    }
  }
}
