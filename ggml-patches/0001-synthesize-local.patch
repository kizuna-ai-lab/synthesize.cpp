+    const dim3 threads(CUDA_IM2COL_TILE_THREADS, 1, 1);
+    im2col_1d_tiled_f32_kernel<<<blocks, threads, 0, stream>>>(
+        x, dst, IW, OW, KW, IC_KW, input_channel_stride, p0, d0);
+}
