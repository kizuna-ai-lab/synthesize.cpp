  "architecture": {
    "family_basis": "StyleTTS 2 decoder-only with iSTFTNet generator",
    "language_conditioning": "none; the model is language-blind and consumes IPA phoneme token IDs plus a voice style vector",
    "modules": {
      "bert": "ALBERT (PL-BERT) with one shared layer group replayed for 12 hidden layers",
      "bert_encoder": "Linear 768 -> 512",
      "predictor": "DurationEncoder (3x BiLSTM + AdaLayerNorm), shared BiLSTM, duration projection, F0/N AdaIN residual stacks",
      "text_encoder": "embedding + 3 weight-normalized Conv1d/LayerNorm blocks + BiLSTM",
      "decoder": "AdaIN residual encode/decode stack + iSTFTNet Generator with harmonic-plus-noise source"
    },
    "dims": {
      "n_token": 178,
      "vocab_entries": 114,
      "hidden_dim": 512,
      "style_dim": 128,
      "n_mels": 80,
      "max_dur": 50,
      "n_layer": 3,
      "plbert": {
        "hidden_size": 768,
        "num_attention_heads": 12,
        "intermediate_size": 2048,
        "max_position_embeddings": 512,
        "num_hidden_layers": 12,
        "dropout": 0.1
      },
      "istftnet": {
        "upsample_kernel_sizes": [
          20,
          12
        ],
        "upsample_rates": [
          10,
          6
        ],
        "gen_istft_hop_size": 5,
        "gen_istft_n_fft": 20,
        "resblock_dilation_sizes": [
          [
            1,
            3,
            5
          ],
          [
            1,
            3,
            5
          ],
          [
            1,
            3,
            5
          ]
        ],
        "resblock_kernel_sizes": [
          3,
          7,
          11
        ],
        "upsample_initial_channel": 512
      }
    },
    "audio": {
      "sample_rate": 24000,
      "channel_count": 1,
      "samples_per_duration_frame": 600,
      "frame_chain": "pred_dur -> x2 AdainResBlk1d upsample -> x10 -> x6 ConvTranspose -> x5 iSTFT hop"
    },
    "context_limit": {
      "context_length": 512,
      "max_style_rows": 510,
      "max_final_tokens": 512
    },
    "new_ggml_operator_surface": [
      "bidirectional LSTM (5 instances; no native GGML operator)",
      "InstanceNorm1d with affine parameters (AdaIN1d)",
      "Snake1D activation x + (1/a) * sin(a*x)^2",
      "forward STFT and inverse iSTFT with n_fft 20, hop 5, periodic Hann, center padding",
      "cumulative sum over time for sine phase accumulation",
      "linear and nearest interpolation resampling",
      "grouped (depthwise) ConvTranspose1d in the upsampling AdainResBlk1d pool",
      "ReflectionPad1d"
    ]
  },
  "stochastic_behavior": {
    "is_stochastic": true,
    "sources": [
      "SineGen._f02sine rand_ini: uniform initial phase for harmonics 1..8 (index 0 forced to zero)",
      "SineGen.forward noise: Gaussian additive noise scaled by voiced/unvoiced amplitude",
      "SourceModuleHnNSF.forward noise: Gaussian tensor computed but not consumed by Generator"
    ],
    "measured": {
      "unseeded_runs_identical_pcm": false,
